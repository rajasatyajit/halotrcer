# Shared settings of the Halotrcer apt and yum repositories (rajasatyajit/packages,
# gh-pages). The first product to publish copies this file to repo-meta.env at
# the root of gh-pages; from then on every publish (Tokvera's and Sievant's)
# reads that copy, so the two products describe the repositories identically.
# Tokvera keeps an identical copy of this file. Strict KEY=value lines, read by
# scripts/release/package-repos.sh, never sourced.
REPO_ORIGIN=Halotrcer
REPO_LABEL=Halotrcer
REPO_DESCRIPTION=Halotrcer packages (Tokvera, Sievant), signed by Halotrcer Packages
REPO_ARCHITECTURES=amd64 arm64
